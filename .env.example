# Copy to .env.local for local development. Never commit real values.

# Supabase → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Server-only. Never expose to the browser.
SUPABASE_SECRET_KEY=sb_secret_xxx

# Public URL of the app (used in links sent to clients)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Show the design preview (sample data) on Vercel preview deployments
ENABLE_DESIGN_PREVIEW=0
